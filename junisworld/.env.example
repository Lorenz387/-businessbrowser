# Junis AI (Claude API). Ohne Schlüssel zeigen KI-Funktionen einen Einrichtungshinweis.
ANTHROPIC_API_KEY=
# Optional: Modell überschreiben (Standard: claude-opus-5)
# JUNIS_MODEL=claude-opus-5
# Alternative: Google Gemini (wird genutzt, wenn kein Anthropic-Schlüssel gesetzt ist
# oder JUNIS_AI_PROVIDER=gemini). Schlüssel: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# JUNIS_AI_PROVIDER=gemini

# Öffentliche URL der App (für Stripe-Weiterleitungen und Origin-Prüfung). Lokal leer lassen.
# APP_URL=https://app.example.com
PORT=8787

# Stripe (optional). Ohne Schlüssel können keine kostenpflichtigen Tarife gebucht werden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
STRIPE_PRICE_TEAMS_MONTHLY=
STRIPE_PRICE_TEAMS_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Rechtliche Angaben (Impressum) — vom Betreiber auszufüllen
LEGAL_OPERATOR_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# PersonalAI: Befehle, Dateien und Web-Zugriff auf DIESEM Rechner erlauben.
# Nur für die lokale Nutzung auf dem eigenen PC einschalten — nie auf einem Server.
# PERSONALAI_TOOLS=on
# Weitere Anbieter (alternativ in der App eintragbar)
# OPENAI_API_KEY=
# XAI_API_KEY=
